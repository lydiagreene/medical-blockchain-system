# ───────────────────────────────────────────
# ERROR TRACKING — SENTRY
# ───────────────────────────────────────────
# Get your DSN from https://sentry.io — leave empty to disable
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=

# Optional: tag releases in Sentry error reports
# APP_VERSION=1.0.0


# ───────────────────────────────────────────
# DJANGO SETTINGS
# ───────────────────────────────────────────

# Generate a strong secret key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production — enables all security hardening automatically
DEBUG=True

# Development: 127.0.0.1,localhost
# Production:  yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Production: ALLOWED_HOSTS=verifydoc.ug,www.verifydoc.ug

# React frontend origins allowed to call the API (comma-separated, no trailing slash)
# Dev: leave empty — localhost:5173 is always allowed
# CORS_ALLOWED_ORIGINS=https://verifydoc.ug,https://www.verifydoc.ug


# ───────────────────────────────────────────
# PRODUCTION SECURITY (only needed when DEBUG=False)
# ───────────────────────────────────────────

# Set to False only if you're behind an SSL-terminating load balancer
# that already handles the redirect (e.g. Render, Railway, Heroku)
SECURE_SSL_REDIRECT=True

# HSTS duration in seconds (31536000 = 1 year). Start with 300 for testing.
SECURE_HSTS_SECONDS=31536000


# ───────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────

# Development (SQLite — no setup needed):
DATABASE_URL=sqlite:///db.sqlite3
# Production (PostgreSQL):
# DATABASE_URL=postgres://user:password@localhost:5432/verifydoc


# ───────────────────────────────────────────
# BLOCKCHAIN SETTINGS
# ───────────────────────────────────────────

# Sepolia testnet RPC URL — we get this from Infura (we set this up shortly)
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/your-infura-project-id

# Your MetaMask wallet address (the 0x... address)
DEPLOYER_ADDRESS=your-metamask-wallet-address-here

# Your MetaMask private key (we show you how to get this safely)
DEPLOYER_PRIVATE_KEY=your-private-key-here

# Smart contract address — filled in after deployment
CONTRACT_ADDRESS=your-contract-address-after-deployment


# ───────────────────────────────────────────
# PINATA IPFS SETTINGS
# ───────────────────────────────────────────

# Get these from your free Pinata account (we set this up shortly)
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key
PINATA_BASE_URL=https://api.pinata.cloud


# ───────────────────────────────────────────
# LICENSE EXPIRY ALERTS
# ───────────────────────────────────────────
# Run this command daily to auto-expire overdue credentials and
# send 30/7/1-day warning emails to issuers and admins:
#
#   python manage.py check_license_expiry
#
# Windows Task Scheduler (daily at 7am):
#   Action: C:\...\venv\Scripts\python.exe
#   Args:   manage.py check_license_expiry
#   Start in: C:\path\to\medical-blockchain-system
#
# Linux cron (add to crontab -e):
#   0 7 * * * /path/to/venv/bin/python /path/to/manage.py check_license_expiry


# ───────────────────────────────────────────
# EMAIL SETTINGS
# ───────────────────────────────────────────

# ── OPTION 1: Console (default for dev) ──────────────────────────────────────
# Emails print to the Django terminal — no external service needed.
# Copy the verification/reset link from the terminal output.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=noreply@verifydoc.ug

# ── OPTION 2: Mailtrap (recommended — see real formatted emails in browser) ───
# Free at mailtrap.io → Email Testing → My Inbox → Show Credentials → Django
# Catches all emails locally; nothing reaches real inboxes.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=<mailtrap-username>
# EMAIL_HOST_PASSWORD=<mailtrap-password>
# EMAIL_USE_TLS=True

# ── OPTION 3: Gmail SMTP (real emails to inboxes you own) ─────────────────────
# Requires Gmail App Password (NOT your login password):
# Google Account → Security → 2-Step Verification → App passwords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_USE_TLS=True

# ───────────────────────────────────────────
# AFRICA'S TALKING — SMS
# ───────────────────────────────────────────
# Leave blank to disable SMS (emails still work without it)
# Sandbox for testing: AT_USERNAME=sandbox (any key works in sandbox mode)
AT_USERNAME=
AT_API_KEY=
# Alphanumeric Sender ID (must be registered with Africa's Talking — can take 1-2 days)
AT_SENDER_ID=VerifyDoc
# OR use a shortcode instead of sender ID
# AT_SHORTCODE=12345
# Country dialling code (Uganda = 256). Used to normalise local numbers (07xx → +256xxx)
AT_COUNTRY_CODE=256


# ───────────────────────────────────────────
# DOCKER / PRODUCTION DATABASE
# ───────────────────────────────────────────
# Used by docker-compose to set the postgres superuser password.
# DATABASE_URL is overridden inside docker-compose.yml to point at the db service.
POSTGRES_PASSWORD=change_me_in_production


# Base URL used in email links (no trailing slash)
# Development:
SITE_URL=http://127.0.0.1:8000
# Production: set to your real domain
# SITE_URL=https://verifydoc.ug

# React frontend URL — password reset emails link here so users land on the SPA, not Django
# Development (Vite dev server):
FRONTEND_URL=http://localhost:5173
# Production (same domain as SITE_URL when Django serves the built React app):
# FRONTEND_URL=https://verifydoc.ug

WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/your-infura-project-id
CONTRACT_ADDRESS=your-contract-address-after-deployment
DEPLOYER_ADDRESS=your-metamask-wallet-address-here
DEPLOYER_PRIVATE_KEY=your-private-key-here





